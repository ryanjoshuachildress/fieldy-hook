# Port the server listens on
PORT=3000

# Secret token Fieldy must present (query param ?token=... or Authorization: Bearer ...)
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=replace-me-with-a-long-random-token

# Where the SQLite database lives (created if missing)
DB_PATH=data/events.db